# Copy to e2e/.env.local (gitignored via the root .env.local pattern
# does not cover this file — keep it out of git yourself) or export
# these in your shell before `pnpm test:e2e`.

# Clerk test user. Email defaults to eva@vedantb.com if omitted.
E2E_USER_EMAIL=eva@vedantb.com
E2E_USER_PASSWORD=

# Target. Production is the default so CI does not need a local stack.
# Local Vite: E2E_BASE_URL=http://localhost:5173 (pnpm dev)
E2E_BASE_URL=https://vmem.vedantb.com

# Mintlify preview (pnpm docs:dev). Specs skip if this is not reachable.
# E2E_DOCS_URL=http://localhost:3001

# Set to 1 to start `pnpm --filter web dev` before the suite (local only).
# E2E_WEB_SERVER=1
