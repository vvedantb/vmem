{
  "installCommand": "cd ../.. && HUSKY=0 pnpm install --frozen-lockfile --filter web...",
  "buildCommand": "cd ../.. && pnpm sdk:build && pnpm --filter web build",
  "redirects": [
    {
      "source": "/slides",
      "destination": "https://openwork.vedantb.com/slides/intro-to-vmem",
      "permanent": false
    },
    {
      "source": "/slides/(.*)",
      "destination": "https://openwork.vedantb.com/slides/intro-to-vmem",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
