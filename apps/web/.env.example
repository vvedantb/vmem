# Required by apps/web/src/env.ts
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Optional: local Vite /?agent Clerk ticket sign-in (apps/web/vite.config.ts)
# Copy the secret from the Clerk dashboard; AGENT_CLERK_USER_ID is the user_…
# id to mint a 60s sign-in token for. Dev-only — not used in production builds.
CLERK_SECRET_KEY=sk_test_your_secret_key_here
AGENT_CLERK_USER_ID=user_your_agent_user_id_here
