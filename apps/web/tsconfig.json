{
  "extends": "@vvedantb/config/tsconfig/web.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsgo/web.tsbuildinfo",
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "vite.config.ts"]
}
