abler-icon-menu-2 "><path d="M4 6l16 0"></path><path d="M4 12l16 0"></path><path d="M4 18l16 0"></path></svg></button></div></div></header><main><div class="landing-atmosphere landing-grain relative overflow-hidden border-b border-separator"><div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true"><div class="landing-ambient-graph-mask absolute inset-0 opacity-[0.28]" style="background-image:radial-gradient(circle, color-mix(in oklch, var(--foreground) 8%, transparent) 1px, transparent 1px);background-size:32px 32px"></div><div class="absolute -right-[12%] top-[2%] h-[min(78dvh,580px)] w-[min(78vw,580px)] rounded-full bg-foreground/[0.06] blur-3xl"></div><div class="absolute -left-[6%] bottom-[8%] h-80 w-80 rounded-full bg-surface-tertiary/40 blur-3xl"></div><div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_55%_at_50%_42%,transparent_18%,var(--background)_88%)]"></div><svg class="landing-ambient-drift landing-ambient-graph-mask absolute inset-0 h-full w-full text-foreground/[0.08]" viewBox="0 0 900 700" preserveAspectRatio="xMidYMid slice" fill="none"><path d="M140 420 C 260 300, 340 480, 460 340 S 660 200, 780 280" stroke="currentColor" stroke-width="1" stroke-dasharray="4 6" class="landing-graph-dash"></path><path d="M200 160 C 300 220, 400 140, 520 220 S 680 360, 800 280" stroke="currentColor" stroke-width="1"></path><path d="M520 220 L 460 340 L 660 200" stroke="currentColor" stroke-width="0.75" opacity="0.6"></path><path d="M200 160 L 460 340" stroke="currentColor" stroke-width="0.75" opacity="0.5"></path><path d="M620 120 L 720 200 L 660 320" stroke="currentColor" stroke-width="0.65" opacity="0.35"></path><g class="landing-ambient-node-a"><circle cx="140" cy="420" r="5" fill="currentColor"></circle></g><g class="landing-ambient-node-b"><circle cx="460" cy="340" r="8" fill="currentColor"></circle></g><g class="landing-ambient-node-c"><circle cx="780" cy="280" r="5" fill="currentColor"></circle></g><g class="landing-ambient