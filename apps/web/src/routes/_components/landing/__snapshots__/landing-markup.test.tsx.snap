abler-icon-menu-2 "><path d="M4 6l16 0"></path><path d="M4 12l16 0"></path><path d="M4 18l16 0"></path></svg></button></div></div></header><main><div class="landing-atmosphere landing-grain relative overflow-hidden border-b border-separator"><div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true"><div class="landing-ambient-graph-mask absolute inset-0 opacity-[0.28]" style="background-image:radial-gradient(circle, color-mix(in oklch, var(--foreground) 8%, transparent) 1px, transparent 1px);background-size:32px 32px"></div><div class="absolute -right-[12%] top-[2%] h-[min(78dvh,580px)] w-[min(78vw,580px)] rounded-full bg-foreground/[0.06] blur-3xl"></div><div class="absolute -left-[6%] bottom-[8%] h-80 w-80 rounded-full bg-surface-tertiary/40 blur-3xl"></div><div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_55%_at_50%_42%,transparent_18%,var(--background)_88%)]"></div><svg class="landing-ambient-drift landing-ambient-graph-mask absolute inset-0 h-full w-full text-foreground/[0.08]" viewBox="0 0 900 700" preserveAspectRatio="xMidYMid slice" fill="none"><path d="M140 420 C 260 300, 340 480, 460 340 S 660 200, 780 280" stroke="currentColor" stroke-width="1" stroke-dasharray="4 6" class="landing-graph-dash"></path><path d="M200 160 C 300 220, 400 140, 520 220 S 680 360, 800 280" stroke="currentColor" stroke-width="1"></path><path d="M520 220 L 460 340 L 660 200" stroke="currentColor" stroke-width="0.75" opacity="0.6"></path><path d="M200 160 L 460 340" stroke="currentColor" stroke-width="0.75" opacity="0.5"></path><path d="M620 120 L 720 200 L 660 320" stroke="currentColor" stroke-width="0.65" opacity="0.35"></path><g class="landing-ambient-node-a"><circle cx="140" cy="420" r="5" fill="currentColor"></circle></g><g class="landing-ambient-node-b"><circle cx="460" cy="340" r="8" fill="currentColor"></circle></g><g class="landing-ambient-node-c"><circle cx="780" cy="280" r="5" fill="currentColor"></circle></g><g class="landing-ambient-node-d"><circle cx="200" cy="160" r="4" fill="currentColor"></circle></g><g class="landing-ambient-node-e"><circle cx="520" cy="220" r="6" fill="currentColor"></circle></g><g class="landing-ambient-node-f"><circle cx="660" cy="200" r="4" fill="currentColor"></circle></g><g class="landing-ambient-node-g"><circle cx="800" cy="280" r="5" fill="currentColor"></circle></g><g class="landing-ambient-node-h"><circle cx="720" cy="200" r="3.5" fill="currentColor" opacity="0.5"></circle></g></svg><div class="landing-hero-read-scrim absolute inset-0"></div></div><section class="relative mx-auto w-full max-w-6xl px-5 sm:px-8 lg:px-10 pb-16 pt-12 sm:pb-20 sm:pt-20 lg:pb-24 lg:pt-24"><div class="mx-auto max-w-3xl text-center"><p class="mb-6 inline-flex items-center gap-2 rounded-full border border-separator bg-surface/70 px-3 py-1 text-xs text-muted" style="opacity:0;filter:blur(4px);transform:translateY(14px)"><span class="landing-pulse-dot size-1.5 rounded-full bg-foreground" aria-hidden="true"></span>Memory engine for AI agents</p><h1 class="text-balance font-semibold text-[2.35rem] leading-[1] tracking-[-0.035em] text-foreground min-[400px]:text-[2.85rem] sm:text-6xl lg:text-[4.85rem]" style="opacity:0;filter:blur(4px);transform:translateY(14px)">Memory your agents can <span class="italic text-foreground/85">actually use</span></h1><p class="mx-auto mt-5 max-w-xl text-pretty text-[0.9375rem] leading-relaxed text-muted sm:mt-6 sm:text-lg" style="opacity:0;filter:blur(4px);transform:translateY(14px)">Store context from chats and tools, connect it in a graph, and retrieve the slice that matters — with a Context Trace that shows why each memory matched.</p><div class="mt-7 flex flex-col items-stretch justify-center gap-2.5 sm:mt-9 sm:flex-row sm:items-center sm:gap-3" style="opacity:0;filter:blur(4px);transform:translateY(14px)"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg text-sm font-medium tracking-normal transition-[transform,backg