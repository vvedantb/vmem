{
  "name": "@vmem/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "vmem desktop activity recorder",
  "author": "vmem",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "smoke": "node scripts/build.mjs && VMEM_DESKTOP_SMOKE=1 electron . --no-sandbox",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "package": "pnpm build && electron-builder",
    "package:linux": "pnpm build && electron-builder --linux dir",
    "package:win": "pnpm build && electron-builder --win nsis",
    "package:mac": "pnpm build && electron-builder --mac dmg --x64 --arm64"
  },
  "dependencies": {
    "@vmem/sdk": "workspace:*",
    "get-windows": "^9.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:node-types-22",
    "electron": "43.8.0",
    "electron-builder": "^26.8.0",
    "esbuild": "0.25.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
