    "test:e2e:live": "tsx --import ./tests/register-backend-stub.mjs --test --test-concurrency=1 tests/e2e/signed-in.live.e2e.mts",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/chrome-extension": "catalog:",
    "@floating-ui/dom": "^1.7.6",
    "@mozilla/readability": "^0.5.0",
