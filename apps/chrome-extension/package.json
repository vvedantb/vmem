    "@tabler/icons-react": "catalog:",
    "@vmem/backend": "workspace:*",
    "@vmem/shared": "workspace:*",
    "@vmem/ui": "workspace:*",
    "@webext-core/messaging": "^2.3.0",
    "convex": "catalog:",
    "es-toolkit": "^1.49.0",
    "jwt-decode": "^4.0.0",
    "motion": "^12.34.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadow-plugin": "catalog:",
    "turndown": "^7.2.4",
    "usehooks-ts": "^3.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:tailwind4",
    "@types/chrome": "^0.0.304",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.4.0",
    "happy-dom": "^20.0.2",
    "puppeteer-core": "^24.34.0",
    "tailwindcss": "catalog:tailwind4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "^6.0.0",
    "wxt": "^0.20.27"
  }
