<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Usage Access. The user grants it in system settings (sideloaded build, no Play policy). -->
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Read-only. Used only after the user turns on Calendar in Settings. -->
  <uses-permission android:name="android.permission.READ_CALENDAR" />

  <!-- App names for the review queue and the blocked apps list (Android 11+ package visibility). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
  </queries>

  <application>
    <!-- Share text or a link to vmem: it lands in the review queue (capture kind "share"). -->
    <activity
      android:name="expo.modules.vmemtracker.ShareReceiverActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:label="@string/vmem_tracker_share_label"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/*" />
      </intent-filter>
    </activity>

    <!-- Quick Settings tile: pause or resume recording. -->
    <service
      android:name="expo.modules.vmemtracker.PauseTileService"
      android:exported="true"
      android:icon="@drawable/vmem_tracker_tile"
      android:label="@string/vmem_tracker_tile_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <!-- Re-schedules collection after a reboot or an app update. -->
    <receiver
      android:name="expo.modules.vmemtracker.BootReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
