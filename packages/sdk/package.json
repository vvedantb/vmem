{
  "name": "@vmem/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript SDK for the vmem memory API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:node-types-22",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}
