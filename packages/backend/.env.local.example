# Clerk (set via: npx convex env set CLERK_FRONTEND_API_URL <value>)
CLERK_FRONTEND_API_URL=https://your-clerk-domain.clerk.accounts.dev

# OpenRouter (set via: npx convex env set OPENROUTER_API_KEY <value>)
OPENROUTER_API_KEY=sk-or-replace_me

# Encryption key for API keys (base64-encoded AES-256, 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set via: npx convex env set ENCRYPTION_KEY <value>
ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
