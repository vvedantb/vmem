# Local backend/CLI examples.
# Copy to packages/backend/.env.local for CLI tests/scripts.
# Convex deployment variables should also be set in the Convex dashboard.

# Convex / auth / app URLs
CLERK_FRONTEND_API_URL=https://your-clerk-frontend-api-url
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CONVEX_SITE_URL=https://your-deployment.convex.site
WEB_APP_URL=http://localhost:5173

# Encryption key for API keys and OAuth tokens.
# Must be a base64-encoded 32-byte AES key.
ENCRYPTION_KEY=base64_encoded_32_byte_key_here

# Neo4j memory graph
NEO4J_URI=neo4j+s://your-database.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_MAX_POOL_SIZE=10
NEO4J_CONNECTION_ACQUISITION_TIMEOUT_MS=10000

# Optional model / embedding behavior
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
OPENROUTER_LOG_PROMPTS=0
VMEM_ENABLE_QUERY_EXPANSION=0
VMEM_ENABLE_RERANK=0

# Optional OAuth connectors
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Live HTTP Memories API integration tests
RUN_HTTP_API_TEST=0
VMEM_API_KEY=vmem_sk_your_api_key_here
VMEM_HTTP_API_BASE_URL=https://your-deployment.convex.site

# Retrieval evals / behavioral tests
RUN_RETRIEVAL_EVAL=0


