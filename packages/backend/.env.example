# Local backend/CLI examples.
# Copy to packages/backend/.env.local for CLI tests/scripts.
# Convex deployment variables should also be set in the Convex dashboard
# (Settings → Environment Variables or `npx convex env set`).
# There is no in-app Secrets page; the AI Gateway key is deployment env only.

# Convex / auth / app URLs
# Production Convex (clear-bear-690) uses the Project V Clerk instance:
#   CLERK_FRONTEND_API_URL=https://clerk.projectv.uk
#   CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsucHJvamVjdHYudWsk
#   CLERK_SECRET_KEY=sk_live_… (same instance; never commit)
# Dev Convex uses the Project V dev instance:
#   CLERK_FRONTEND_API_URL=https://allowing-coyote-80.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://your-clerk-frontend-api-url
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CONVEX_SITE_URL=https://your-deployment.convex.site
WEB_APP_URL=http://localhost:5173

# Encryption key for API keys and OAuth tokens.
# Must be a base64-encoded 32-byte AES key.
ENCRYPTION_KEY=base64_encoded_32_byte_key_here

# Vercel AI Gateway: chat, embeddings, and Jev (`typesafe-ai/jev`).
# Chat/extract and embeddings require it. Jev retrieve rerank and Dream merge
# metadata turn on when it is set (HTTP/SDK judge: "off" is ablation-only).
# Never commit the real key. Cloud agents may omit it; retrieve then stays hybrid.
AI_GATEWAY_API_KEY=your_ai_gateway_key_here
OPENROUTER_LOG_PROMPTS=0
VMEM_ENABLE_QUERY_EXPANSION=0

# Optional OAuth connectors
# Every provider redirects to ${CONVEX_SITE_URL}/api/auth/connector/callback.
# Google Drive and Gmail share these. Enable the Drive API and Gmail API, and add
# the drive.readonly and gmail.readonly scopes on the consent screen.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
# Figma OAuth app (scopes: current_user:read file_content:read file_comments:read folders:read)
FIGMA_CLIENT_ID=your_figma_client_id
FIGMA_CLIENT_SECRET=your_figma_client_secret
# Figma cannot list a user's teams. Comma-separated team IDs from figma.com/files/.../team/<id>
FIGMA_TEAM_IDS=
# GitHub OAuth App (scopes: read:user repo)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Live HTTP Memories API integration tests
RUN_HTTP_API_TEST=0
VMEM_API_KEY=vmem_sk_your_api_key_here
VMEM_HTTP_API_BASE_URL=https://your-deployment.convex.site

# Live MCP harness (Clerk OAuth access token, not a session JWT)
RUN_MCP_LIVE=0
MCP_BEARER_TOKEN=

# Retrieval evals
RUN_RETRIEVAL_EVAL=0
# Live Jev on the labelled IR harness (requires AI_GATEWAY_API_KEY).
# Treats Jev as default-on; hybrid-only uses eval judge: "off".
# Mocking Jev is not valid for labelled Jev numbers.
EVAL_JEV=0
# Optional concurrency for EVAL_JEV (default 4, max 8)
# EVAL_JEV_CONCURRENCY=4

# Labelled IR head-to-head vs Mem0 + SuperMemory (fails closed without both keys).
# EVAL_COMPETITIVE=1
# MEM0_API_KEY=
# SUPERMEMORY_API_KEY=
# Optional shared subset (same queries for every system):
# COMPETITIVE_QUERY_LIMIT=
# COMPETITIVE_MEMORY_LIMIT=
# COMPETITIVE_SKIP_INGEST=0
# COMPETITIVE_VENDOR_DEFAULTS=0


