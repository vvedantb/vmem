{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "target": "ESNext",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsgo/backend.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["./**/*"],
  "exclude": ["_generated"]
}
