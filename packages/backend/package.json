{
  "name": "@vmem/backend",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "dev": "convex dev",
    "deploy": "pnpm run build:mcp-graph-ui && convex deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:retrieval": "cross-env RUN_RETRIEVAL_EVAL=1 vitest run neo4j-cli/eval/retrieval.integration.test.ts",
    "test:http-api": "node --env-file=.env.local ../../node_modules/vitest/vitest.mjs run neo4j-cli/http/v1Memories.integration.test.ts",
    "db:seed": "npx tsx --env-file=.env.local neo4j-cli/seed/run.ts",
    "db:seed:eval": "npx tsx --env-file=.env.local neo4j-cli/eval/seed.ts",
    "db:unseed": "npx tsx --env-file=.env.local neo4j-cli/unseed.ts",
    "db:tag-stats": "npx tsx --env-file=.env.local neo4j-cli/tag-stats.ts",
    "eval:retrieval": "npx tsx --env-file=.env.local neo4j-cli/eval/run.ts",
    "build:mcp-graph-ui": "node scripts/build-memory-graph-mcp-app.mjs"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "catalog:",
    "@clerk/backend": "catalog:",
    "@convex-dev/action-cache": "^0.3.0",
    "@convex-dev/action-retrier": "^0.3.0",
    "@convex-dev/agent": "catalog:",
    "@convex-dev/crons": "^0.2.0",
    "@convex-dev/workflow": "^0.4.2",
    "@googleapis/drive": "^20.0.0",
    "@googleapis/gmail": "^17.0.0",
    "@modelcontextprotocol/ext-apps": "1.7.2",
    "@modelcontextprotocol/sdk": "catalog:",
    "@neo4j/cypher-builder": "^3.0.1",
    "@notionhq/client": "^2.2.15",
    "@openrouter/ai-sdk-provider": "catalog:",
    "@openrouter/sdk": "^0.12.35",
    "@vmem/shared": "workspace:*",
    "ai": "catalog:",
    "convex": "catalog:",
    "convex-audit-log": "^0.2.0",
    "convex-helpers": "catalog:",
    "jsonwebtoken": "catalog:",
    "neo4j-driver": "^5.28.3",
    "pdf-parse": "^1.1.1",
    "tar-stream": "^3.2.0",
    "ts-morph": "^24.0.0",
    "zod": "catalog:",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:node-types-22",
    "@types/pdf-parse": "^1.1.4",
    "@types/tar-stream": "^3.1.4",
    "@typescript/native-preview": "catalog:",
    "convex-test": "^0.0.38",
    "cross-env": "^7.0.3",
    "esbuild": "0.25.0",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
