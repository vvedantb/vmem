{
  "name": "@vmem/backend",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./index.ts",
    "./memoryRagPrompt": "./src/memoryRagPrompt.ts",
    "./enrichmentPrompt": "./src/enrichmentPrompt.ts"
  },
  "scripts": {
    "dev": "npx convex dev",
    "deploy": "pnpm run build:mcp-assets && npx convex deploy",
    "build:mcp-assets": "pnpm run build:mcp-graph-ui && pnpm run build:mcp-favicon",
    "build:mcp-favicon": "node scripts/build-mcp-favicon.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:retrieval": "cross-env RUN_RETRIEVAL_EVAL=1 vitest run src/neo4j/memory/eval/retrieval.integration.test.ts",
    "db:seed": "npx tsx --env-file=.env.local src/neo4j/seed/run.ts",
    "db:seed:eval": "npx tsx --env-file=.env.local src/neo4j/memory/eval/seed.ts",
    "db:unseed": "npx tsx --env-file=.env.local src/neo4j/unseed.ts",
    "eval:retrieval": "npx tsx --env-file=.env.local src/neo4j/memory/eval/run.ts",
    "build:mcp-graph-ui": "node scripts/build-memory-graph-mcp-app.mjs"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "catalog:",
    "@clerk/backend": "catalog:",
    "@convex-dev/action-cache": "^0.3.0",
    "@convex-dev/action-retrier": "^0.3.0",
    "@convex-dev/agent": "catalog:",
    "@convex-dev/crons": "^0.2.0",
    "@convex-dev/workflow": "^0.4.2",
    "@modelcontextprotocol/ext-apps": "1.7.2",
    "@modelcontextprotocol/sdk": "catalog:",
    "@neo4j/cypher-builder": "^3.0.1",
    "@notionhq/client": "^2.2.15",
    "@openrouter/sdk": "^0.12.35",
    "ai": "catalog:",
    "convex": "catalog:",
    "convex-audit-log": "^0.2.0",
    "convex-helpers": "catalog:",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "catalog:",
    "neo4j-driver": "^5.28.3",
    "pdf-parse": "^1.1.1",
    "tar-stream": "^3.2.0",
    "ts-morph": "^24.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:node-types-22",
    "@types/pdf-parse": "^1.1.4",
    "@types/tar-stream": "^3.1.4",
    "@typescript/native-preview": "catalog:",
    "convex-test": "^0.0.38",
    "cross-env": "^7.0.3",
    "esbuild": "0.25.0",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
