{
  "name": "@vmem/backend",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "dev": "convex dev",
    "typecheck": "tsc -p tsconfig.json",
    "deploy": "pnpm run build:mcp-graph-ui && convex deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:http-api": "node --env-file=.env.local ../../node_modules/vitest/vitest.mjs run tests/integration/v1Memories.integration.test.ts",
    "test:behavioral": "cross-env RUN_RETRIEVAL_EVAL=1 node --env-file=.env.local ../../node_modules/vitest/vitest.mjs run tests/integration/neo4jBehavioral.integration.test.ts",
    "db:tag-stats": "npx tsx --env-file=.env.local neo4j-cli/tag-stats.ts",
    "eval:bench": "npx tsx --env-file=.env.local neo4j-cli/eval/benchmark.ts",
    "build:mcp-graph-ui": "node scripts/build-memory-graph-mcp-app.mjs"
  },
  "dependencies": {
    "@clerk/backend": "catalog:",
    "@convex-dev/action-cache": "^0.3.0",
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/crons": "^0.2.0",
    "@convex-dev/workpool": "^0.4.7",
    "@googleapis/drive": "^20.0.0",
    "@modelcontextprotocol/ext-apps": "1.7.2",
    "@modelcontextprotocol/sdk": "catalog:",
    "@notionhq/client": "^5.23.0",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-retry": "^8.1.0",
    "@openrouter/sdk": "^0.12.35",
    "@scure/base": "^2.2.0",
    "@vmem/sdk": "workspace:*",
    "@vmem/shared": "workspace:*",
    "arctic": "~3.7.0",
    "convex": "catalog:",
    "convex-audit-log": "^0.2.0",
    "convex-helpers": "catalog:",
    "es-toolkit": "^1.49.0",
    "json-from-llm": "^0.2.6",
    "jsonrepair": "^3.15.0",
    "neo4j-driver": "^5.28.3",
    "p-retry": "^8.0.0",
    "remove-markdown": "^0.6.4",
    "tar-stream": "^3.2.0",
    "ts-morph": "^24.0.0",
    "unpdf": "^1.6.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "catalog:node-types-22",
    "@types/remove-markdown": "^0.3.4",
    "@types/tar-stream": "^3.1.4",
    "convex-test": "^0.0.38",
    "cross-env": "^7.0.3",
    "esbuild": "0.25.0",
    "typescript": "catalog:",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
