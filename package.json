{
  "name": "vmem",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "ext:dev": "pnpm --filter @vmem/chrome-extension dev",
    "ext:build": "pnpm --filter @vmem/chrome-extension build",
    "lint": "oxlint --type-aware --deny-warnings && eslint . --max-warnings 0",
    "lint:oxlint": "oxlint --type-aware",
    "lint:eslint": "eslint .",
    "compiler:check": "node scripts/compiler-check.mjs",
    "knip": "knip --no-config-hints",
    "test:oxlint-plugin": "node --test oxlint-plugin-vmem/test/rules.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck:all && pnpm knip && pnpm test:oxlint-plugin && pnpm compiler:check && pnpm test && pnpm format:check",
    "typecheck": "pnpm --filter web typecheck",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "typecheck:all": "pnpm --parallel --filter web --filter @vmem/backend --filter @vmem/sdk --filter @vmem/shared --filter @vmem/ui --filter @vmem/chrome-extension typecheck && pnpm typecheck:e2e",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:e2e:smoke": "playwright test --config e2e/playwright.config.ts --grep @smoke",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "convex": "pnpm --filter @vmem/backend dev",
    "convex:deploy": "pnpm --filter @vmem/backend run deploy",
    "prepare": "husky",
    "lint:deps": "syncpack lint",
    "fix:deps": "syncpack fix-mismatches",
    "sdk:build": "pnpm --filter @vmem/sdk build",
    "sdk:typecheck": "pnpm --filter @vmem/sdk typecheck",
    "test": "pnpm --filter @vmem/backend test && pnpm --filter web test && pnpm --filter @vmem/chrome-extension test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,mdx,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:node-types-22",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^6.26.0",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.8.1",
    "syncpack": "^14.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  }
}
