{
  "name": "vmem",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "ext:dev": "pnpm --filter @vmem/chrome-extension dev",
    "ext:build": "pnpm --filter @vmem/chrome-extension build",
    "lint": "oxlint --type-aware --deny-warnings && eslint . --max-warnings 0",
    "lint:oxlint": "oxlint --type-aware",
    "lint:eslint": "eslint .",
    "knip": "knip --no-config-hints",
    "test:oxlint-plugin": "node --test oxlint-plugin-vmem/test/rules.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck:all && pnpm knip && pnpm test:oxlint-plugin && pnpm test && pnpm format:check",
    "typecheck": "pnpm --filter web typecheck",
    "typecheck:all": "pnpm --parallel --filter web --filter @vmem/backend --filter @vmem/sdk --filter @vmem/shared --filter @vmem/ui --filter @vmem/chrome-extension typecheck",
    "convex": "pnpm --filter @vmem/backend dev",
    "convex:deploy": "pnpm --filter @vmem/backend run deploy",
    "prepare": "husky",
    "lint:deps": "syncpack lint",
    "fix:deps": "syncpack fix-mismatches",
    "sdk:build": "pnpm --filter @vmem/sdk build",
    "sdk:typecheck": "pnpm --filter @vmem/sdk typecheck",
    "test": "pnpm --filter @vmem/backend test && pnpm --filter web test",
    "test:retrieval": "pnpm --filter @vmem/backend test:retrieval",
    "test:mcp": "node scripts/test-vmem-mcp.mjs",
    "eval:retrieval": "pnpm --filter @vmem/backend eval:retrieval",
    "db:seed": "pnpm --filter @vmem/backend db:seed",
    "db:seed:eval": "pnpm --filter @vmem/backend db:seed:eval",
    "db:unseed": "pnpm --filter @vmem/backend db:unseed"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,mdx,html,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "react-native-worklets": "0.7.4"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^6.26.0",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "^3.8.1",
    "syncpack": "^14.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  }
}
