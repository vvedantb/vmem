{
  "name": "vmem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "turbo": "pnpm --filter web turbo",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "mcp:dev": "pnpm --filter mcp dev",
    "mcp:build": "pnpm --filter mcp build",
    "mcp:start": "pnpm --filter mcp start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "convex": "pnpm --filter @vmem/backend dev",
    "convex:deploy": "pnpm --filter @vmem/backend run deploy",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  }
}
