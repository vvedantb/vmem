{
  "name": "vmem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "turbo": "pnpm --filter web turbo",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "api:dev": "pnpm --filter @vmem/api dev",
    "mcp:dev": "pnpm --filter mcp dev",
    "mcp:build": "pnpm --filter mcp build",
    "mcp:start": "pnpm --filter mcp start",
    "ext:dev": "pnpm --filter @vmem/chrome-extension dev",
    "ext:build": "pnpm --filter @vmem/chrome-extension build",
    "mobile": "pnpm --filter mobile start",
    "android": "pnpm --filter mobile android",
    "prebuild:android": "pnpm --filter mobile prebuild:android",
    "clean:android": "pnpm --filter mobile clean:android",
    "docs:dev": "pnpm --filter docs exec mint dev --port 3001",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "convex": "pnpm --filter @vmem/backend dev",
    "convex:deploy": "pnpm --filter @vmem/backend run deploy",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "react-native-worklets": "0.7.4"
    }
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.9.19",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  }
}
