{
  "$schema": "https://unpkg.com/syncpack/dist/schema.json",
  "versionGroups": [
    {
      "label": "@types/node varies by runtime target",
      "dependencies": ["@types/node"],
      "isIgnored": true
    },
    {
      "label": "Tailwind 4 in chrome-extension",
      "dependencies": ["tailwindcss", "@tailwindcss/*"],
      "packages": ["@vmem/chrome-extension"],
      "pinVersion": "catalog:tailwind4"
    },
    {
      "label": "Tailwind 3 in web",
      "dependencies": ["tailwindcss"],
      "packages": ["web"],
      "pinVersion": "catalog:tailwind3"
    },
    {
      "label": "Loose peer deps in @vmem/ui — intentionally wide ranges",
      "dependencies": [
        "react",
        "react-dom",
        "ai",
        "motion",
        "nanoid",
        "streamdown",
        "@streamdown/*",
        "use-stick-to-bottom"
      ],
      "packages": ["@vmem/ui"],
      "isIgnored": true
    },
    {
      "label": "All other deps should use default catalog or highest semver",
      "dependencies": ["**"],
      "packages": ["**"],
      "preferVersion": "highestSemver"
    }
  ]
}
