{
  "$schema": "https://unpkg.com/syncpack/dist/schema.json",
  "versionGroups": [
    {
      "label": "@types/node varies by runtime target",
      "dependencies": ["@types/node"],
      "isIgnored": true
    },
    {
      "label": "Tailwind 4 in web and chrome-extension",
      "dependencies": ["tailwindcss", "@tailwindcss/*"],
      "packages": ["web", "@vmem/chrome-extension"],
      "pinVersion": "catalog:tailwind4"
    },
    {
      "label": "Tailwind 3 in mobile (NativeWind 4)",
      "dependencies": ["tailwindcss"],
      "packages": ["@vmem/mobile"],
      "pinVersion": "catalog:tailwind3"
    },
    {
      "label": "Expo SDK pins React and React Native in mobile",
      "dependencies": [
        "react",
        "react-dom",
        "react-native",
        "react-native-*",
        "expo",
        "expo-*",
        "@expo/*"
      ],
      "packages": ["@vmem/mobile"],
      "isIgnored": true
    },
    {
      "label": "Published vv-ui packages stay pinned to npm",
      "dependencies": ["@vvedantb/ui"],
      "packages": ["web", "@vmem/chrome-extension"],
      "isIgnored": true
    },
    {
      "label": "All other deps should use default catalog or highest semver",
      "dependencies": ["**"],
      "packages": ["**"],
      "preferVersion": "highestSemver"
    }
  ]
}
